---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const construct8Url = "https://us-central1-river-octagon-219300.cloudfunctions.net/construct8-v2";

// Read all sprites from the public directory at build time
const spritesDir = path.join(process.cwd(), 'public/assets/sprites/ffrk');
const availableSprites = fs.existsSync(spritesDir)
  ? fs.readdirSync(spritesDir)
      .filter(file => file.endsWith('.png'))
      .map(file => file.replace('.png', '').toLowerCase())
  : [];

const isDev = import.meta.env.DEV;

// Configured skeleton card counts per role: [1, 3, 11, 11, 1]
const skeletonRoles = [1, 3, 11, 11, 1];
---

<Layout
  title="Members"
  description="Complete list of all Members currently in the community."
  icon="members"
>
  <!-- Google Fonts: Prompt (600) for Canvas rendering, matching the Avatar Icon Generator -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@600&display=swap" rel="stylesheet" />

  <style>
    .skeleton {
      background-color: var(--bs-secondary-bg-subtle);
      border-radius: 0.5rem;
      position: relative;
      overflow: hidden;
      transition: background-color 0.2s;
    }
    .skeleton::after {
      content: '';
      display: block;
      position: absolute;
      top: 0;
      left: -150px;
      height: 100%;
      width: 150px;
      background: linear-gradient(90deg, transparent, var(--bs-secondary-bg) 40%, transparent 80%);
      animation: shimmer 1.2s infinite;
      transition: background 0.2s;
    }
    @keyframes shimmer {
      100% {
        left: 100%;
      }
    }
  </style>

  <div
    id="memberlist-container"
    data-url={isDev ? '/members.json' : `${construct8Url}/members.json`}
    data-sprites={JSON.stringify(availableSprites)}
    data-dev={isDev ? "true" : "false"}
  >
    <!-- Shimmer skeleton is rendered statically on the server to prevent FOUC / CLS -->
    <div id="memberlist-skeleton">
      {skeletonRoles.map((count) => (
        <div>
          <div class="skeleton h5 fw-light w-25 mb-3">&nbsp;</div>
          <div class="mb-4">
            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4">
              {Array.from({ length: count }).map(() => (
                <div class="col">
                  <div class="card rounded-5 shadow-sm position-relative overflow-hidden">
                    <div class="card-img-top p-3 pb-0 mx-auto">
                      <div class="skeleton ratio ratio-1x1 rounded-5"></div>
                    </div>
                    <div class="card-body text-center">
                      <div class="skeleton h6 card-title fw-light w-75 mx-auto">&nbsp;</div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
    <div id="memberlist" style="display:none"></div>
  </div>

  <script>
    import '../js/members';
  </script>
</Layout>
