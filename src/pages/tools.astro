---
import fs from 'node:fs';
import Layout from '../layouts/Layout.astro';

// Load template from the txt file at build-time
let initialTemplate = "";
try {
  initialTemplate = fs.readFileSync('public/tools/bot_welcome_message.txt', 'utf8');
} catch (e) {
  initialTemplate = `Welcome, {member}, to the grand stage of **{server_name}**! I'm {username}, your guide.`;
}
---

<Layout
  title="Resources Hub"
  description="Official community brand assets and developer utilities for the Ivalice Alliance."
  custom_icon="fa-solid fa-cubes"
>
  <p class="mb-4 text-center text-md-start">
    Access official branding assets, export custom-sized logo files, or use developer utilities to test bot integrations and onboarding flows.
  </p>

  <!-- Navigation Tab Bar -->
  <div class="text-center mb-5">
    <div class="nav nav-pills custom-nav-pills" id="resourcesTab" role="tablist">
      <button 
        class="nav-link active" 
        id="assets-tab" 
        data-bs-toggle="pill" 
        data-bs-target="#assets-pane" 
        type="button" 
        role="tab" 
        aria-controls="assets-pane" 
        aria-selected="true"
      >
        <i class="fa-solid fa-stamp me-2"></i>Brand Assets
      </button>
      <button 
        class="nav-link" 
        id="sandbox-tab" 
        data-bs-toggle="pill" 
        data-bs-target="#sandbox-pane" 
        type="button" 
        role="tab" 
        aria-controls="sandbox-pane" 
        aria-selected="false"
      >
        <i class="fa-solid fa-terminal me-2"></i>Developer Sandbox
      </button>
    </div>
  </div>

  <!-- Tab Content Panels -->
  <div class="tab-content animate-fade-in" id="resourcesTabContent">
    <!-- Tab 1: Brand Assets -->
    <div class="tab-pane fade show active" id="assets-pane" role="tabpanel" aria-labelledby="assets-tab" tabindex="0">
      <div class="row g-4 mb-5">
        <!-- Logo Imprint Card -->
        <div class="col-12">
          <div class="card border-0 bg-body-tertiary rounded-5 shadow-sm p-4 p-md-5 transition-hover">
            <div class="row align-items-center">
              <div class="col-md-3 text-center mb-4 mb-md-0">
                <div class="d-inline-block rounded-5 p-4 bg-primary bg-opacity-10 text-primary">
                  <i class="fa-solid fa-stamp fa-4x fa-fw"></i>
                </div>
              </div>
              <div class="col-md-9 text-center text-md-start">
                <h3 class="fw-bold mb-2">Logo Imprint Builder</h3>
                <p class="text-body-secondary flex-grow-1 mb-4">
                  Export the official community logo in custom sizes up to 4000x4000 pixels. 
                  Perfect for members making custom swag, T-shirts, stickers, or digital graphics. Features alignment guides and color masks.
                </p>
                <a href="/tools/imprint.html" class="btn btn-outline-primary rounded-pill px-4 py-2">
                  Launch Builder <i class="fa-solid fa-wand-magic-sparkles ms-1"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Downloads Section -->
      <div class="card border-0 bg-body-tertiary rounded-5 shadow-sm p-4 p-md-5 mb-0">
        <h4 class="fw-bold mb-4"><i class="fa-solid fa-download me-2 text-primary"></i>Quick Asset Downloads</h4>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
          <!-- Item 1: SVG Logo -->
          <div class="col">
            <div class="card h-100 border rounded-4 bg-body p-3 d-flex flex-column justify-content-between transition-hover">
              <div>
                <div class="text-center mb-3">
                  <div class="rounded-3 bg-secondary bg-opacity-10 text-secondary p-3 d-inline-block">
                    <i class="fa-solid fa-bezier-curve fa-2x"></i>
                  </div>
                </div>
                <h5 class="fw-semibold mb-1 text-center">Official SVG Logo</h5>
                <p class="small text-body-secondary mb-3">Scalable vector graphics logo file. Ideal for design software.</p>
              </div>
              <a href="/assets/images/logo.svg" download class="btn btn-sm btn-outline-secondary rounded-pill w-100">
                <i class="fa-solid fa-arrow-down me-1"></i> Download SVG
              </a>
            </div>
          </div>
          <!-- Item 2: Optically Centered -->
          <div class="col">
            <div class="card h-100 border rounded-4 bg-body p-3 d-flex flex-column justify-content-between transition-hover">
              <div>
                <div class="text-center mb-3">
                  <div class="rounded-3 bg-secondary bg-opacity-10 text-secondary p-3 d-inline-block">
                    <i class="fa-solid fa-image fa-2x"></i>
                  </div>
                </div>
                <h5 class="fw-semibold mb-1 text-center">Optically Centered</h5>
                <p class="small text-body-secondary mb-3">Imprint with corrected optical alignment in PNG format.</p>
              </div>
              <a href="/assets/images/monochrome-imprint-centered.png" download class="btn btn-sm btn-outline-secondary rounded-pill w-100">
                <i class="fa-solid fa-arrow-down me-1"></i> Download PNG
              </a>
            </div>
          </div>
          <!-- Item 3: Tight Crop (No Padding) -->
          <div class="col">
            <div class="card h-100 border rounded-4 bg-body p-3 d-flex flex-column justify-content-between transition-hover">
              <div>
                <div class="text-center mb-3">
                  <div class="rounded-3 bg-secondary bg-opacity-10 text-secondary p-3 d-inline-block">
                    <i class="fa-solid fa-image fa-2x"></i>
                  </div>
                </div>
                <h5 class="fw-semibold mb-1 text-center">Tight Crop (No Padding)</h5>
                <p class="small text-body-secondary mb-3">Cropped to the bounds of the horizontal design with zero margins.</p>
              </div>
              <a href="/assets/images/monochrome-imprint.png" download class="btn btn-sm btn-outline-secondary rounded-pill w-100">
                <i class="fa-solid fa-arrow-down me-1"></i> Download PNG
              </a>
            </div>
          </div>
          <!-- Item 4: Favicon PNG -->
          <div class="col">
            <div class="card h-100 border rounded-4 bg-body p-3 d-flex flex-column justify-content-between transition-hover">
              <div>
                <div class="text-center mb-3">
                  <div class="rounded-3 bg-secondary bg-opacity-10 text-secondary p-3 d-inline-block">
                    <i class="fa-solid fa-circle-user fa-2x"></i>
                  </div>
                </div>
                <h5 class="fw-semibold mb-1 text-center">Web Favicon</h5>
                <p class="small text-body-secondary mb-3">High-resolution square shortcut icon in PNG format.</p>
              </div>
              <a href="/assets/images/favicon.png" download class="btn btn-sm btn-outline-secondary rounded-pill w-100">
                <i class="fa-solid fa-arrow-down me-1"></i> Download PNG
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 2: Developer Sandbox -->
    <div class="tab-pane fade" id="sandbox-pane" role="tabpanel" aria-labelledby="sandbox-tab" tabindex="0">
      <div class="row g-4 mb-5">
        <!-- Icon Generator Card -->
        <div class="col-12">
          <div class="card border-0 bg-body-tertiary rounded-5 shadow-sm p-4 p-md-5 transition-hover">
            <div class="row align-items-center">
              <div class="col-md-3 text-center mb-4 mb-md-0">
                <div class="d-inline-block rounded-5 p-4 bg-primary bg-opacity-10 text-primary">
                  <i class="fa-solid fa-wand-magic-sparkles fa-4x fa-fw"></i>
                </div>
              </div>
              <div class="col-md-9 text-center text-md-start">
                <h3 class="fw-bold mb-2">Avatar Icon Generator</h3>
                <p class="text-body-secondary mb-4">
                  Generate and export custom, high-resolution avatar placeholders matching the clan's typography and color schemes. 
                  Useful for setting up mock members, service bots, or testing new color gradients.
                </p>
                <a href="/tools/icongen.html" class="btn btn-outline-primary rounded-pill px-4 py-2">
                  Launch Generator <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Discord Onboarding Section -->
      <div class="card rounded-5 shadow-sm border-0 bg-body-tertiary p-4 p-md-5 mb-0">
        <div class="row align-items-center mb-4">
          <div class="col-auto">
            <div class="rounded-4 p-3 bg-info bg-opacity-10 text-info">
              <i class="fa-brands fa-discord fa-2x fa-fw"></i>
            </div>
          </div>
          <div class="col">
            <h3 class="m-0 fw-semibold">Discord Welcome Message</h3>
            <p class="text-body-secondary m-0">Onboarding welcome template for the server's welcoming bot.</p>
          </div>
        </div>

        <div class="row g-4">
          <!-- Input Controls -->
          <div class="col-lg-4">
            <h5 class="fw-semibold mb-3">Live Parameters</h5>
            <div class="mb-3">
              <label for="welcome-member" class="form-label small fw-medium">Member Name (&#123;member&#125;)</label>
              <input type="text" class="form-control rounded-3" id="welcome-member" value="Cloud" placeholder="e.g. Cloud" />
            </div>
            <div class="mb-3">
              <label for="welcome-server" class="form-label small fw-medium">Server Name (&#123;server_name&#125;)</label>
              <input type="text" class="form-control rounded-3" id="welcome-server" value="Ivalice Alliance" placeholder="e.g. Ivalice Alliance" />
            </div>
            <div class="mb-3">
              <label for="welcome-username" class="form-label small fw-medium">Bot Name (&#123;username&#125;)</label>
              <input type="text" class="form-control rounded-3" id="welcome-username" value="CaitSith" placeholder="e.g. CaitSith" />
            </div>
          </div>

          <!-- Live Preview & Raw Code -->
          <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h5 class="fw-semibold m-0">Output Preview</h5>
              <div class="btn-group btn-group-sm" role="group" aria-label="Copy options">
                <button type="button" class="btn btn-secondary rounded-start-pill" id="btn-copy-interpolated">
                  <i class="fa-solid fa-copy me-1"></i> Copy Rendered
                </button>
                <button type="button" class="btn btn-outline-secondary rounded-end-pill" id="btn-copy-template">
                  <i class="fa-solid fa-code me-1"></i> Copy Template
                </button>
              </div>
            </div>

            <div class="position-relative">
              <textarea 
                class="form-control font-monospace text-body bg-body rounded-4 p-4" 
                id="welcome-output" 
                rows="9" 
                readonly 
                style="font-size: 0.9rem; resize: none; border: 1px solid var(--bs-border-color);"
              ></textarea>
              <div 
                class="position-absolute top-50 start-50 translate-middle badge bg-success p-3 rounded-3 shadow d-none" 
                id="copy-toast" 
                style="font-size: 1rem; z-index: 10;"
              >
                <i class="fa-solid fa-check me-2"></i> Copied to clipboard!
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Premium Segmented Controls for Tabs */
    .custom-nav-pills {
      background: var(--bs-tertiary-bg);
      padding: 0.35rem;
      border-radius: 50rem;
      border: 1px solid var(--bs-border-color);
      display: flex;
      width: max-content;
      max-width: 100%;
      margin: 0 auto;
      flex-wrap: nowrap;
    }
    .custom-nav-pills .nav-link {
      color: var(--bs-secondary-color);
      border-radius: 50rem;
      font-weight: 600;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      border: none;
      background: transparent;
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      
      flex: 1;
      padding: 0.6rem clamp(0.5rem, 3vw - 0.25rem, 1.75rem);
      font-size: clamp(0.85rem, 0.5vw + 0.75rem, 0.95rem);
    }
    .custom-nav-pills .nav-link.active {
      background: var(--bs-primary);
      color: #fff !important;
      box-shadow: 0 4px 12px rgba(var(--bs-primary-rgb), 0.25);
    }
    .custom-nav-pills .nav-link:hover:not(.active) {
      color: var(--bs-primary);
      background: rgba(var(--bs-primary-rgb), 0.08);
    }

    /* Animation effects */
    .animate-fade-in {
      animation: fadeIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .transition-hover {
      transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out, border-color 0.2s ease-in-out;
    }
    .transition-hover:hover {
      transform: translateY(-4px);
      box-shadow: var(--bs-box-shadow) !important;
      border-color: rgba(var(--bs-primary-rgb), 0.25) !important;
    }
  </style>

  <!-- Interactive script to handle the Discord template interpolation and copy-to-clipboard -->
  <script is:inline define:vars={{ initialTemplate }}>
    document.addEventListener('DOMContentLoaded', () => {
      const memberInput = document.getElementById('welcome-member');
      const serverInput = document.getElementById('welcome-server');
      const usernameInput = document.getElementById('welcome-username');
      const outputTextarea = document.getElementById('welcome-output');
      const copyInterpolatedBtn = document.getElementById('btn-copy-interpolated');
      const copyTemplateBtn = document.getElementById('btn-copy-template');
      const copyToast = document.getElementById('copy-toast');

      let templateText = initialTemplate;

      function stripFrontmatter(text) {
        if (!text) return '';
        if (text.startsWith('---')) {
          const parts = text.split('---');
          if (parts.length >= 3) {
            return parts.slice(2).join('---').trim();
          }
        }
        return text.trim();
      }

      templateText = stripFrontmatter(templateText);

      function renderTemplate() {
        const member = memberInput.value || '';
        const serverName = serverInput.value || '';
        const username = usernameInput.value || '';
        
        let rendered = templateText
          .replace(/{member}/g, member)
          .replace(/{server_name}/g, serverName)
          .replace(/{username}/g, username);

        outputTextarea.value = rendered;
      }

      function showToast() {
        copyToast.classList.remove('d-none');
        setTimeout(() => {
          copyToast.classList.add('d-none');
        }, 1500);
      }

      memberInput.addEventListener('input', renderTemplate);
      serverInput.addEventListener('input', renderTemplate);
      usernameInput.addEventListener('input', renderTemplate);

      copyInterpolatedBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(outputTextarea.value).then(() => {
          showToast();
        });
      });

      copyTemplateBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(templateText).then(() => {
          showToast();
        });
      });

      // Fetch dynamic updates at runtime from public file
      fetch('/tools/bot_welcome_message.txt')
        .then((res) => {
          if (!res.ok) throw new Error('Network error');
          return res.text();
        })
        .then((text) => {
          templateText = stripFrontmatter(text);
          renderTemplate();
        })
        .catch((err) => {
          console.warn('Could not fetch runtime welcome template, falling back to build-time version.', err);
        });

      // Initial render
      renderTemplate();
    });
  </script>
</Layout>
