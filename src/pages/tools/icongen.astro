---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Icon Generator"
  description="Generate customized, theme-compliant brand avatar placeholders."
  custom_icon="fa-solid fa-wand-magic-sparkles"
>
  <!-- Google Fonts: Prompt (600) for Canvas rendering -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@600&display=swap" rel="stylesheet" />

  <div class="row g-4 mb-5">
    <!-- Configuration Panel -->
    <div class="col-lg-5">
      <div class="card border-0 bg-body-tertiary rounded-5 shadow-sm p-4 p-md-5 h-100">
        <h4 class="fw-semibold mb-4 text-center text-lg-start">Configuration</h4>

        <!-- Text Settings -->
        <div class="mb-4">
          <label for="icon-text" class="form-label small fw-medium">Icon Text</label>
          <input type="text" class="form-control rounded-3" id="icon-text" value="Sc" maxlength="4" placeholder="e.g. Sc" />
          <div class="form-text">Max 4 characters. Keep it brief for best display.</div>
        </div>

        <div class="row mb-4 g-3">
          <div class="col-6">
            <label for="font-family" class="form-label small fw-medium">Font Family</label>
            <select class="form-select rounded-3" id="font-family">
              <option value="Prompt" selected>Prompt</option>
              <option value="Raleway">Raleway</option>
              <option value="sans-serif">Sans-Serif</option>
            </select>
          </div>
          <div class="col-6">
            <label for="text-color" class="form-label small fw-medium">Text Color</label>
            <div class="d-flex align-items-center">
              <input type="color" class="form-control form-control-color rounded-3 w-100" id="text-color" value="#FFFFFF" title="Choose text color" />
            </div>
          </div>
        </div>

        <!-- Background Settings -->
        <div class="mb-4">
          <label class="form-label small fw-medium d-block">Background Style</label>
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="bg-style" id="bg-style-solid" value="solid" checked />
            <label class="form-check-input-label" for="bg-style-solid">Solid Color</label>
          </div>
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="bg-style" id="bg-style-gradient" value="gradient" />
            <label class="form-check-input-label" for="bg-style-gradient">Gradient</label>
          </div>
        </div>

        <!-- Background Color Controls -->
        <div class="mb-4" id="solid-color-wrap">
          <label for="bg-color-solid" class="form-label small fw-medium">Background Color</label>
          <input type="color" class="form-control form-control-color rounded-3 w-100" id="bg-color-solid" value="#1975D2" title="Choose background color" />
        </div>

        <div class="mb-4 d-none" id="gradient-color-wrap">
          <div class="row g-3">
            <div class="col-6">
              <label for="bg-color-start" class="form-label small fw-medium">Start Color</label>
              <input type="color" class="form-control form-control-color rounded-3 w-100" id="bg-color-start" value="#1975D2" />
            </div>
            <div class="col-6">
              <label for="bg-color-end" class="form-label small fw-medium">End Color</label>
              <input type="color" class="form-control form-control-color rounded-3 w-100" id="bg-color-end" value="#C2185C" />
            </div>
          </div>
          <div class="mt-3">
            <label for="gradient-angle" class="form-label small fw-medium">Gradient Angle (<span id="angle-val">135</span>°)</label>
            <input type="range" class="form-range" id="gradient-angle" min="0" max="360" value="135" />
          </div>
        </div>

        <!-- Presets -->
        <div>
          <h5 class="fw-semibold small text-uppercase text-body-secondary mb-3">Role Presets</h5>
          <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 preset-btn" data-text="Sc" data-color="#1975d2">
              Save Crystal (Sc)
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 preset-btn" data-text="Cs" data-color="#6e4797">
              Cait Sith (Cs)
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 preset-btn" data-text="Cn" data-color="#c2185c">
              Construct8 (Cn)
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 preset-btn" data-text="Ia" data-gradient-start="#FF6F61" data-gradient-end="#5B7EBD">
              Clan Brand (Ia)
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Live Preview Panel -->
    <div class="col-lg-7">
      <div class="card border-0 bg-body-tertiary rounded-5 shadow-sm p-4 p-md-5 h-100 text-center d-flex flex-column align-items-center justify-content-center">
        <h4 class="fw-semibold mb-4">Live Preview</h4>

        <!-- Preview Box (1x1 square) -->
        <div class="position-relative shadow-lg rounded-5 overflow-hidden mb-4 border" style="width: 100%; max-width: 320px; aspect-ratio: 1/1;">
          <canvas id="preview-canvas" style="width: 100%; height: 100%; display: block;"></canvas>
        </div>

        <!-- Export controls -->
        <div class="w-100" style="max-width: 320px;">
          <h5 class="fw-semibold small text-body-secondary mb-3">Export Assets</h5>
          <div class="d-grid gap-2">
            <button type="button" class="btn btn-primary rounded-pill py-2" id="export-1024">
              <i class="fa-solid fa-download me-2"></i>Download PNG (1024x1024)
            </button>
            <div class="row g-2">
              <div class="col-6">
                <button type="button" class="btn btn-outline-primary rounded-pill py-2 w-100" id="export-512">
                  512x512
                </button>
              </div>
              <div class="col-6">
                <button type="button" class="btn btn-outline-primary rounded-pill py-2 w-100" id="export-256">
                  256x256
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="text-center mb-5">
    <a href="/tools.html" class="btn btn-outline-secondary rounded-pill">
      <i class="fa-solid fa-chevron-left me-1"></i> Back to Tools
    </a>
  </div>

  <!-- Native client-side script for responsive drawing, Font load trigger, and PNG download downloads -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const textInput = document.getElementById('icon-text');
      const fontFamilySelect = document.getElementById('font-family');
      const textColorInput = document.getElementById('text-color');
      const bgStyleSolid = document.getElementById('bg-style-solid');
      const bgStyleGradient = document.getElementById('bg-style-gradient');
      
      const solidWrap = document.getElementById('solid-color-wrap');
      const gradientWrap = document.getElementById('gradient-color-wrap');
      
      const solidColorInput = document.getElementById('bg-color-solid');
      const startColorInput = document.getElementById('bg-color-start');
      const endColorInput = document.getElementById('bg-color-end');
      const gradientAngleInput = document.getElementById('gradient-angle');
      const angleValSpan = document.getElementById('angle-val');
      
      const canvas = document.getElementById('preview-canvas');
      const ctx = canvas.getContext('2d');
      
      // Set export resolution
      canvas.width = 1024;
      canvas.height = 1024;

      function renderIcon() {
        const text = textInput.value || '';
        const fontFamily = fontFamilySelect.value;
        const textColor = textColorInput.value;
        const isGradient = bgStyleGradient.checked;

        // Clear canvas
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Draw Background
        if (isGradient) {
          const start = startColorInput.value;
          const end = endColorInput.value;
          const angleDeg = parseInt(gradientAngleInput.value, 10);
          
          // Convert angle to gradient coordinate vector
          const angleRad = (angleDeg * Math.PI) / 180;
          
          // Calculate vector points for canvas sizing (1024x1024)
          const halfW = canvas.width / 2;
          const halfH = canvas.height / 2;
          
          const x1 = halfW - Math.cos(angleRad) * halfW;
          const y1 = halfH - Math.sin(angleRad) * halfH;
          const x2 = halfW + Math.cos(angleRad) * halfW;
          const y2 = halfH + Math.sin(angleRad) * halfH;

          const grad = ctx.createLinearGradient(x1, y1, x2, y2);
          grad.addColorStop(0, start);
          grad.addColorStop(1, end);
          ctx.fillStyle = grad;
        } else {
          ctx.fillStyle = solidColorInput.value;
        }
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Draw Text
        ctx.fillStyle = textColor;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        
        // Adjust font size based on text length to avoid overflow
        let fontSize = 640;
        if (text.length > 2) {
          fontSize = 640 - (text.length - 2) * 120;
        }
        
        ctx.font = `600 ${fontSize}px ${fontFamily}`;
        ctx.fillText(text, canvas.width / 2, canvas.height / 2);
      }

      // Handle visibility of color configuration panels
      function updateBgMode() {
        if (bgStyleGradient.checked) {
          solidWrap.classList.add('d-none');
          gradientWrap.classList.remove('d-none');
        } else {
          solidWrap.classList.remove('d-none');
          gradientWrap.classList.add('d-none');
        }
        renderIcon();
      }

      // Monitor color modes
      bgStyleSolid.addEventListener('change', updateBgMode);
      bgStyleGradient.addEventListener('change', updateBgMode);

      // Input change listeners
      textInput.addEventListener('input', renderIcon);
      fontFamilySelect.addEventListener('change', renderIcon);
      textColorInput.addEventListener('input', renderIcon);
      solidColorInput.addEventListener('input', renderIcon);
      startColorInput.addEventListener('input', renderIcon);
      endColorInput.addEventListener('input', renderIcon);
      gradientAngleInput.addEventListener('input', () => {
        angleValSpan.textContent = gradientAngleInput.value;
        renderIcon();
      });

      // Handle Presets
      document.querySelectorAll('.preset-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const text = btn.getAttribute('data-text');
          const color = btn.getAttribute('data-color');
          const gStart = btn.getAttribute('data-gradient-start');
          const gEnd = btn.getAttribute('data-gradient-end');

          if (text) textInput.value = text;
          
          if (color) {
            bgStyleSolid.checked = true;
            solidColorInput.value = color;
            updateBgMode();
          } else if (gStart && gEnd) {
            bgStyleGradient.checked = true;
            startColorInput.value = gStart;
            endColorInput.value = gEnd;
            updateBgMode();
          }
        });
      });

      // Export file downloads
      function downloadPng(size) {
        // Create matching-size temporary canvas to redraw correctly
        const tempCanvas = document.createElement('canvas');
        tempCanvas.width = size;
        tempCanvas.height = size;
        const tempCtx = tempCanvas.getContext('2d');

        // Draw background matching original parameters
        const isGradient = bgStyleGradient.checked;
        if (isGradient) {
          const start = startColorInput.value;
          const end = endColorInput.value;
          const angleDeg = parseInt(gradientAngleInput.value, 10);
          const angleRad = (angleDeg * Math.PI) / 180;
          
          const half = size / 2;
          const x1 = half - Math.cos(angleRad) * half;
          const y1 = half - Math.sin(angleRad) * half;
          const x2 = half + Math.cos(angleRad) * half;
          const y2 = half + Math.sin(angleRad) * half;

          const grad = tempCtx.createLinearGradient(x1, y1, x2, y2);
          grad.addColorStop(0, start);
          grad.addColorStop(1, end);
          tempCtx.fillStyle = grad;
        } else {
          tempCtx.fillStyle = solidColorInput.value;
        }
        tempCtx.fillRect(0, 0, size, size);

        // Draw Text
        const text = textInput.value || '';
        tempCtx.fillStyle = textColorInput.value;
        tempCtx.textAlign = 'center';
        tempCtx.textBaseline = 'middle';
        
        let fontSize = size * 0.625;
        if (text.length > 2) {
          fontSize = fontSize - (text.length - 2) * (size * 0.12);
        }
        
        tempCtx.font = `600 ${fontSize}px ${fontFamilySelect.value}`;
        tempCtx.fillText(text, size / 2, size / 2);

        // Download
        const link = document.createElement('a');
        link.download = `avatar-${text || 'icon'}-${size}x${size}.png`;
        link.href = tempCanvas.toDataURL('image/png');
        link.click();
      }

      document.getElementById('export-1024').addEventListener('click', () => downloadPng(1024));
      document.getElementById('export-512').addEventListener('click', () => downloadPng(512));
      document.getElementById('export-256').addEventListener('click', () => downloadPng(256));

      // Wait for fonts (especially google fonts) to load before drawing initial state
      if (document.fonts) {
        document.fonts.ready.then(() => {
          renderIcon();
        });
      } else {
        setTimeout(renderIcon, 500); // Fallback for older environments
      }
    });
  </script>
</Layout>
