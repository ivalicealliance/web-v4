---
import fs from 'node:fs';
import yaml from 'js-yaml';

// Load site configuration and data
const siteTitle = "Ivalice Alliance";
const siteDiscord = "https://discord.gg/TEVk6n5";

// Parse YAML files
const navigation = yaml.load(fs.readFileSync('src/data/navigation.yml', 'utf8')) as Record<string, any>;
const themes = yaml.load(fs.readFileSync('src/data/themes.yml', 'utf8')) as Array<{ text: string; icon: string }>;

// Helper to determine active state
const currentPath = Astro.url.pathname;
const isActive = (link: string, exact = true) => {
  if (!link) return false;
  const normalize = (path: string) => {
    return path
      .replace(/^\//, '')
      .replace(/\/$/, '')
      .replace(/\.html$/, '')
      .replace(/index$/, '');
  };
  const normLink = normalize(link);
  const normCurrent = normalize(currentPath);
  if (normLink === '') {
    return normCurrent === '';
  }
  if (exact) {
    return normCurrent === normLink;
  }
  return normCurrent === normLink || normCurrent.startsWith(normLink + '/');
};
---

<nav class="navbar navbar-expand-lg p-0">
  <div class="container-xl p-4 border border-top-0 rounded-bottom-5 shadow-sm">
    <a class="navbar-brand" href="/">
      <h2 class="d-inline">{siteTitle}</h2>
    </a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#naviar_id"
      aria-controls="naviar_id"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="naviar_id">
      <ul class="navbar-nav me-auto mb-2 mb-md-0">
        {
          Object.entries(navigation).map(([key, element]) => {
            if (element.dropdown) {
              const dropdownActive = element.dropdown.some((subItem: any) => isActive(subItem.link, true));
              return (
                <li class="nav-item dropdown">
                  <button
                    class={`nav-link dropdown-toggle bg-transparent border-0${dropdownActive ? " active" : ""}`}
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                  >
                    <i class={`${element.icon} fa-fw`} />
                    <span class="ps-2">{element.text}</span>
                  </button>
                  <ul class="dropdown-menu shadow-sm">
                    {element.dropdown.map((subItem: any) => {
                      const subActive = isActive(subItem.link, true);
                      const subLink = '/' + subItem.link;
                      return (
                        <li>
                          <a
                            class={`dropdown-item d-flex align-items-center${subActive ? " dropdown-item-active" : ""}`}
                            href={subLink}
                            aria-current={subActive ? "page" : undefined}
                          >
                            <i class={`${subItem.icon} fa-fw me-2 ${subActive ? "text-primary" : "opacity-75"}`} />
                            <span>{subItem.text}</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </li>
              );
            }

            let navLink = "";
            let target = null;
            let rel = null;

            if (element.external) {
              navLink = element.external.replace('!discord', siteDiscord);
              target = "_blank";
              rel = "noopener noreferrer";
            } else {
              navLink = element.link === 'index.html' ? '/' : '/' + element.link;
            }

            const active = !element.external && isActive(element.link, true);

            return (
              <li class="nav-item">
                <a
                  class={`nav-link${active ? " active" : ""}`}
                  aria-current={active ? "page" : undefined}
                  href={navLink}
                  target={target}
                  rel={rel}
                >
                  <i class={`${element.icon} fa-fw`} />
                  <span class="ps-2">{element.text}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
      
      <!-- Theme Selection Dropdown -->
      <ul class="navbar-nav flex-row flex-wrap ms-md-auto">
        <li class="nav-item dropdown">
          <button
            class="nav-link dropdown-toggle bg-transparent border-0"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="Change theme"
          >
            <span id="theme-icon-active"></span>
            <span class="d-md-none ms-1">Change theme</span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="--bs-dropdown-min-width: 8rem;">
            {
              themes.map((element) => {
                const themeValue = element.text.toLowerCase();
                return (
                  <li>
                    <button
                      type="button"
                      class="dropdown-item d-flex align-items-center"
                      data-bs-theme-value={themeValue}
                    >
                      <span class="me-2 opacity-50" id={`theme-icon-${themeValue}`}>
                        <i class={`${element.icon} fa-fw`} />
                      </span>
                      {element.text}
                    </button>
                  </li>
                );
              })
            }
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>

<style>
  .dropdown-item-active {
    color: var(--bs-primary) !important;
    font-weight: 600;
    border-left: 3px solid var(--bs-primary);
    padding-left: calc(1rem - 3px) !important;
    background-color: transparent !important;
  }
  .dropdown-item-active:hover, .dropdown-item-active:focus {
    color: var(--bs-primary) !important;
  }
  .dropdown-item-active .me-2 {
    opacity: 1 !important;
    color: var(--bs-primary) !important;
  }
</style>
